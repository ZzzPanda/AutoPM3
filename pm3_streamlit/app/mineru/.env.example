# MinerU API credentials — copy to `.env` and fill in.
# Get a token at https://mineru.net/apiManage/token

MINERU_TOKEN=your-token-here

# Optional: override the API base URL (for staging or proxies)
# MINERU_BASE_URL=https://mineru.net

# Set to 1 to enable the live integration tests in mineru/tests/test_client.py
# (requires MINERU_TOKEN and network access to mineru.net)
MINERU_LIVE=0
