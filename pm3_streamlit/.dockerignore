# Git
.git
.gitignore
.gitattributes
.dockerignore
.github/

# Docker / Compose (build-time, not runtime)
Dockerfile
Dockerfile.*
docker-compose.yml
docker-compose.*.yml
.docker/
docker/

# Saved image exports — `COPY . .` would otherwise re-bake every .tar
# into the next image, making it grow across builds.
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.gz
*.bz2
*.xz

# Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# Secrets — NEVER bake into the image
.env
.env.*
!.env.example
.streamlit/secrets.toml
**/secrets.toml
**/*.pem
**/*.key
config/.env
config/.streamlit/secrets.toml

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# Runtime data — exclude everything in data/ by default; only
# data/protein.txt is whitelisted because the app reads it at runtime.
data/*
!data/protein.txt
data/xml_papers/
data/pdf_convert/

# Streamlit runtime artefacts
xml/
**/*.pdf
**/*.bib
**/*.csv
**/*.tsv
**/*.jsonl

# Build helpers (downloader, build scripts, etc.)
app/data_io/
scripts/

# Build artefacts
*.log
*.log.*
*.tmp
*.bak
*.pid
*.pidfile
build/
dist/
*.deb
*.egg
*.whl

# Local docs / notes / benchmarks
docs/
benchmarks/
*.md
LICENSE
DEPLOY.md
README.md
